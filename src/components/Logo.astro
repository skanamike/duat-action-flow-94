---
interface Props {
  label?: string;
}
const { label = "DUAT" } = Astro.props;
---

<span class="flex items-center gap-2">
  <span class="flex h-8 w-8 items-center justify-center rounded-sm bg-gradient-secondary" aria-hidden="true">
    <span class="h-4 w-4 rotate-45 border-2 border-b-0 border-r-0 border-white"></span>
  </span>
  <span class="text-2xl font-bold text-white">{label}</span>
</span>
