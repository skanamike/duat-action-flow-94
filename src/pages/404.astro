---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description="The page you were looking for doesn't exist." index={false}>
  <section class="flex min-h-[70vh] items-center justify-center px-6 pt-24 text-center">
    <div>
      <p class="mb-2 text-sm font-semibold uppercase tracking-wider text-secondary">404</p>
      <h1 class="mb-4 text-4xl font-bold text-primary md:text-5xl">Page not found</h1>
      <p class="mb-8 text-lg text-muted-foreground">The page you were looking for doesn't exist or has moved.</p>
      <div class="flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/" class="inline-flex h-11 items-center justify-center rounded-md bg-primary px-6 font-medium text-white hover:bg-primary/90">Go to home</a>
        <button type="button" data-contact class="inline-flex h-11 items-center justify-center rounded-md border border-input px-6 font-medium hover:bg-muted">Contact us</button>
      </div>
    </div>
  </section>
</BaseLayout>
