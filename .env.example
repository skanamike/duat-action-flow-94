# REQUIRED. Netlify Function (netlify/functions/contact.mts): where leads are forwarded.
# Set in Netlify → Site configuration → Environment variables (scope: Functions).
# No fallback: if unset, /api/contact returns 503 and the form shows an error.
ZAPIER_WEBHOOK_URL=

# Only for scripts/generate-images.js (local use). Never commit a real value.
HF_TOKEN=
