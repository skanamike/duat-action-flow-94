# Copy to agent-team.env, fill in, then run:
#   templates/agent-team/install.sh /path/to/target-repo agent-team.env
# Values are plain text; keep each on one line. Never put secrets here.

PROJECT_NAME="Acme App"
PROJECT_DESCRIPTION="One-sentence description of what the project is and who it serves."
STACK="e.g. Astro 7 · React 19 · Tailwind 4 · TypeScript · Netlify"
OPERATOR="Your Name"
REPO_URL="https://github.com/owner/repo"
DEFAULT_BRANCH="main"

CMD_CHECK="npm run check"
CMD_LINT="npm run lint"
CMD_TEST="npm test"
CMD_BUILD="npm run build"
CMD_E2E="npm run test:e2e"

REVIEW_FOCUS="what matters most in review for this product (e.g. swipe feel, SEO, data accuracy)"
BRAND_PERSONALITY="three or four adjectives and what they mean"
PERF_BUDGET="e.g. ≤ 40 KB JS per page; no frame drops > 16ms"
SECURITY_FOCUS="e.g. Supabase RLS, OAuth tokens, form endpoints"
RULE_4="e.g. server-side services are containerised; client isolates side effects in adapters"
